---
import FluidInk from "../components/FluidInk.astro";
import PostCard from "../components/PostCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { BLOG, INK, SITE } from "../config";
import { getPublishedPosts } from "../utils/posts";

const posts = (await getPublishedPosts()).slice(0, BLOG.postsOnHome);
---

<BaseLayout overlayHeader>
  <FluidInk variant="hero" enabled={INK.hero} wordmark="kagecrypt">
    <div class="hero">
      <p class="hero__eyebrow">Security researcher</p>
      <h1 class="hero__title">{SITE.title}</h1>
      <p class="hero__lede">{SITE.tagline}</p>
      <p class="hero__cta">
        <a href="/blog/">Read the blog ↓</a>
      </p>
    </div>

  </FluidInk>

  <section class="section wrap">
    <div class="latest__head">
      <h2 class="eyebrow">Latest</h2>
      <a class="latest__all label" href="/blog/">All posts →</a>
    </div>

    <div class="latest__list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  {
    INK.divider && (
      <FluidInk variant="divider" strength={INK.strength * 0.7}>
        <p class="divider__label label">Shadow work</p>
      </FluidInk>
    )
  }
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
    padding: var(--space-24) var(--gutter);
    text-align: center;
  }

  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .hero__title {
    font-family: var(--font-mono);
    /* Sized for the actual word length rather than --text-hero's generic
       clamp, which was tuned for a 4-letter mark and clips a longer one at
       wide viewports. */
    font-size: clamp(3rem, 12vw, 8.5rem);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: var(--tracking-hero);
  }

  .hero__lede {
    max-width: 32rem;
    font-size: var(--text-md);
    color: var(--color-fg-muted);
  }

  .hero__cta a {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    border: var(--rule-width) solid var(--color-accent);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-accent);
    transition:
      background var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .hero__cta a:hover {
    background: var(--color-accent);
    color: var(--color-accent-fg);
  }

  .latest__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-6);
    border-bottom: var(--rule-width) solid var(--color-rule);
  }

  .latest__all {
    text-decoration: none;
  }

  .latest__all:hover {
    color: var(--color-accent);
  }

  .latest__list :global(.post-card:last-child) {
    border-bottom: none;
  }

  .divider__label {
    margin: auto;
    text-align: center;
  }

</style>
